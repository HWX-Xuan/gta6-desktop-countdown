<Window x:Class="Gta6Countdown.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GTA VI · 效果设置"
        Width="1120"
        Height="890"
        MinWidth="980"
        MinHeight="760"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="#0B0710"
        ShowInTaskbar="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B9A9BD" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBackground" Property="Background" Value="#26172D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeBackground" Property="Background" Value="#341C3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBackground" Property="Background" Value="#5A1C31" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeBackground" Property="Background" Value="#7A2441" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#2B1830" BorderThickness="1" Background="#0B0710">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0F0915"
                    BorderBrush="#211326"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="TitleDrag_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="18,0,0,0">
                            <Border Width="28"
                                    Height="28"
                                    CornerRadius="8"
                                    Background="#1D1026"
                                    BorderBrush="#3A2042"
                                    BorderThickness="1">
                                <Image x:Name="AppIcon" Width="22" Height="22" Stretch="Uniform" />
                            </Border>
                            <TextBlock x:Name="TitleText"
                                       Text="GTA VI · 效果设置"
                                       Foreground="#FFF7FB"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                            <TextBlock x:Name="SubtitleText"
                                       Text="效果与系统"
                                       Foreground="#866E8B"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="10,1,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Button x:Name="MinimizeButton"
                                Content="—"
                                Style="{StaticResource ChromeButton}"
                                Click="MinimizeButton_Click" />
                        <Button x:Name="CloseButton"
                                Content="✕"
                                Style="{StaticResource CloseButton}"
                                Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <wv2:WebView2 x:Name="Browser" />
                <Grid x:Name="LoadingPanel" Background="#0B0710">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="VI"
                                   FontFamily="Anton, Segoe UI"
                                   FontSize="58"
                                   Foreground="#FF4CA6"
                                   HorizontalAlignment="Center"
                                   TextOptions.TextRenderingMode="ClearType" />
                        <TextBlock x:Name="LoadingText"
                                   Text="正在加载效果设置…"
                                   Foreground="#BFA8B9"
                                   FontSize="13"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
